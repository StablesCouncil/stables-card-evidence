LET lab=0xF0EC7DA9D13EABE32FA358C410D3153156E18ED362365DA01AC2DC2177AED42F LET labaddr=0xE9373F1602002A51803B645413FC837C0FC51B3671CC4DB9334B91BD39250325 LET reqaddr=0xB13ADD36D874B2E0640AEB1F06B9AC1B5B37EC784AAD318A1463CC13DF2ED3F7 IF SIGNEDBY(lab) THEN LET p=100+@INPUT ASSERT STATE(p) EQ @AMOUNT RETURN VERIFYOUT(@INPUT labaddr STATE(p) @TOKENID FALSE) ENDIF ASSERT GETINADDR(0) EQ reqaddr LET n=STATE(16) ASSERT (@INPUT GTE 1) AND (@INPUT LTE n) AND (n LTE 8) ASSERT STATE(13) EQ @TOKENID ASSERT STATE(12) GT 0 LET sum=0 LET i=1 WHILE i LTE n DO ASSERT GETINADDR(i) EQ @ADDRESS ASSERT GETINTOK(i) EQ @TOKENID LET sum=sum+GETINAMT(i) LET i=i+1 ENDWHILE ASSERT VERIFYOUT(0 STATE(14) STATE(12) @TOKENID FALSE) LET rem=sum-STATE(12) ASSERT STATE(15) EQ rem IF rem GT 0 THEN RETURN VERIFYOUT(2 @ADDRESS STATE(15) @TOKENID FALSE) ENDIF RETURN rem EQ 0
