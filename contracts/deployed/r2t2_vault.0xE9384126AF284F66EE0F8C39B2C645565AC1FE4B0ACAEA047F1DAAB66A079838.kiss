LET lab=0xF0EC7DA9D13EABE32FA358C410D3153156E18ED362365DA01AC2DC2177AED42F LET labaddr=0xE9373F1602002A51803B645413FC837C0FC51B3671CC4DB9334B91BD39250325 LET reqaddr=0xA17D741BC402E9601D1C1FAA6CA162ACD969EDCCCB0F73704696AC5605B7566C IF SIGNEDBY(lab) THEN LET p=100+@INPUT ASSERT STATE(p) EQ @AMOUNT RETURN VERIFYOUT(@INPUT labaddr STATE(p) @TOKENID FALSE) ENDIF ASSERT @INPUT EQ 1 ASSERT GETINADDR(0) EQ reqaddr ASSERT STATE(13) EQ @TOKENID ASSERT STATE(12) GT 0 ASSERT VERIFYOUT(0 STATE(14) STATE(12) @TOKENID FALSE) LET rem=@AMOUNT-STATE(12) ASSERT STATE(15) EQ rem IF rem GT 0 THEN RETURN VERIFYOUT(2 @ADDRESS STATE(15) @TOKENID FALSE) ENDIF RETURN rem EQ 0
