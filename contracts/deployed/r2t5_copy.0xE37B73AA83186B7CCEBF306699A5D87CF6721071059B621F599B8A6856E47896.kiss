LET sealtok=0x3079FF7DF1077EC9755F98C7A042A0553BDD27B9C49E08F1CE7D86982D8AB7BC IF (GETINTOK(0) EQ sealtok) AND (GETINAMT(0) EQ 2) THEN RETURN TRUE ENDIF ASSERT SAMESTATE(80 88) AND SAMESTATE(100 108) ASSERT SAMESTATE(20 24) AND SAMESTATE(26 26) IF (@INPUT EQ 0) AND MULTISIG(3 PREVSTATE(80) PREVSTATE(81) PREVSTATE(82) PREVSTATE(83) PREVSTATE(84) PREVSTATE(85) PREVSTATE(86) PREVSTATE(87) PREVSTATE(88)) THEN ASSERT STATE(27) EQ 1 RETURN VERIFYOUT(STATE(19) @ADDRESS 1 sealtok TRUE) ENDIF ASSERT @INPUT EQ (STATE(16)+1) ASSERT SAMESTATE(27 28) RETURN VERIFYOUT(STATE(19) @ADDRESS 1 sealtok TRUE)
