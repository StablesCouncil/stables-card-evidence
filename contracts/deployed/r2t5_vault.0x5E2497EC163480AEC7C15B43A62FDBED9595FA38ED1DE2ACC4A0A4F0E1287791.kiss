LET reqaddr=0x5BFE17B989A7053037A3E565C42696481952295E20F2EE7128F61713176F907B LET contaddr=0x092183C5904C71124646E339E33C003DD2FF0F3AE250BE752C8CC34C2200164A LET rectok=0x4F422DFFB35256B15525E5C0022B0AFA73392DB6CE70B846764982FA861A17EE ASSERT (GETINADDR(0) EQ reqaddr) OR (GETINADDR(0) EQ contaddr) LET n=STATE(16) ASSERT (@INPUT GTE 1) AND (@INPUT LTE n) AND (n LTE 8) ASSERT GETINTOK(n+2) EQ rectok ASSERT STATE(13) EQ @TOKENID ASSERT STATE(12) GT 0 LET sum=0 LET i=1 WHILE i LTE n DO ASSERT GETINADDR(i) EQ @ADDRESS ASSERT GETINTOK(i) EQ @TOKENID LET sum=sum+GETINAMT(i) LET i=i+1 ENDWHILE ASSERT VERIFYOUT(0 STATE(14) STATE(12) @TOKENID FALSE) LET rem=sum-STATE(12) ASSERT STATE(15) EQ rem IF rem GT 0 THEN RETURN VERIFYOUT(2 @ADDRESS STATE(15) @TOKENID FALSE) ENDIF RETURN rem EQ 0
