LET copyaddr = 0x$COPYADDR
LET sealtok = 0x$SEALTOK
ASSERT MULTISIG(5 0x$K1 0x$K2 0x$K3 0x$K4 0x$K5 0x$K6 0x$K7)
ASSERT VERIFYOUT(0 @ADDRESS 1 sealtok TRUE)
ASSERT VERIFYOUT(1 copyaddr 1 sealtok TRUE)
ASSERT VERIFYOUT(2 copyaddr 1 sealtok TRUE)
ASSERT VERIFYOUT(3 copyaddr 1 sealtok TRUE)
ASSERT STATE(21) EQ (PREVSTATE(21) + 1)
RETURN STATE(22) EQ PREVSTATE(22)
