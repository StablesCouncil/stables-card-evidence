LET lab = 0x$LABKEY
LET labaddr = 0x$LABADDR
LET reqaddr = 0x$REQADDR
IF SIGNEDBY(lab) THEN LET p = 100 + @INPUT ASSERT STATE(p) EQ @AMOUNT RETURN VERIFYOUT(@INPUT labaddr STATE(p) @TOKENID FALSE) ENDIF
ASSERT GETINADDR(0) EQ reqaddr
LET n = STATE(16)
ASSERT (@INPUT GTE 1) AND (@INPUT LTE n) AND (n LTE 8)
ASSERT STATE(13) EQ @TOKENID
ASSERT STATE(12) GT 0
LET sum = 0
LET i = 1
WHILE i LTE n DO ASSERT GETINADDR(i) EQ @ADDRESS ASSERT GETINTOK(i) EQ @TOKENID LET sum = sum + GETINAMT(i) LET i = i + 1 ENDWHILE
ASSERT VERIFYOUT(0 STATE(14) STATE(12) @TOKENID FALSE)
LET rem = sum - STATE(12)
ASSERT STATE(15) EQ rem
IF rem GT 0 THEN RETURN VERIFYOUT(2 @ADDRESS STATE(15) @TOKENID FALSE) ENDIF
RETURN rem EQ 0
