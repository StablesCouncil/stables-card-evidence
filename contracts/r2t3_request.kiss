LET sealaddr = 0x$COPYADDR
LET sealtok = 0x$SEALTOK
ASSERT @INPUT EQ 0
ASSERT SAMESTATE(10 14)
IF MULTISIG(5 0x$K1 0x$K2 0x$K3 0x$K4 0x$K5 0x$K6 0x$K7) THEN RETURN TRUE ENDIF
ASSERT VERIFYOUT(0 STATE(14) STATE(12) STATE(13) FALSE)
ASSERT STATE(17) EQ @AMOUNT
ASSERT VERIFYOUT(1 STATE(14) STATE(17) @TOKENID FALSE)
IF @COINAGE GTE $WAIT THEN RETURN TRUE ENDIF
ASSERT GETINADDR(STATE(16) + 1) EQ sealaddr
ASSERT GETINTOK(STATE(16) + 1) EQ sealtok
RETURN PROOF(@COINID 0 STATE(20) 0 STATE(25))
