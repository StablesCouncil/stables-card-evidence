/* EXIT RECORD, one coin per token per shard (1 record-token unit). Kept from genesis: 35 Council cap and 36 fallback
   cap (per period, this shard), 37 request address, 38 contested address, 39 token, 44 shard. Moving: 40 tree root,
   41 period start, 42 Council paid, 43 fallback paid. Insertion: 45 lower key, 46 next key, 47 and 48 proofs, 49 the
   middle root. The paid card coin's key (first 16 bytes of port 11) goes into a sorted list in a Merkle tree; a coin
   already there can never be paid again, by any path. */
LET rectok = $RECTOK
ASSERT @TOKENID EQ rectok
ASSERT (GETINADDR(0) EQ PREVSTATE(37)) OR (GETINADDR(0) EQ PREVSTATE(38))
ASSERT @INPUT EQ (STATE(16) + 2)
ASSERT SAMESTATE(35 39) AND SAMESTATE(44 44)
ASSERT STATE(13) EQ PREVSTATE(39)
LET x = SUBSET(0 16 STATE(11))
LET b = NUMBER(SUBSET(0 1 x))
ASSERT (b GTE (PREVSTATE(44) * $SHARDWIDTH)) AND (b LT ((PREVSTATE(44) + 1) * $SHARDWIDTH))
LET lo = STATE(45)
LET nx = STATE(46)
LET pa = STATE(47)
LET pb = STATE(48)
ASSERT (LEN(pa) EQ $PROOFLEN) AND (LEN(pb) EQ $PROOFLEN)
LET xh = NUMBER(SUBSET(0 8 x))
LET xl = NUMBER(SUBSET(8 16 x))
LET lh = NUMBER(SUBSET(0 8 lo))
LET ll = NUMBER(SUBSET(8 16 lo))
LET nh = NUMBER(SUBSET(0 8 nx))
LET nl = NUMBER(SUBSET(8 16 nx))
ASSERT (lh LT xh) OR ((lh EQ xh) AND (ll LT xl))
ASSERT (xh LT nh) OR ((xh EQ nh) AND (xl LT nl))
ASSERT PROOF(CONCAT(lo nx) 0 PREVSTATE(40) 0 pa)
ASSERT PROOF(CONCAT(lo x) 0 STATE(49) 0 pa)
ASSERT PROOF(0x00 0 STATE(49) 0 pb)
ASSERT PROOF(CONCAT(x nx) 0 STATE(40) 0 pb)
LET cpaid = PREVSTATE(42)
LET fpaid = PREVSTATE(43)
IF (PREVSTATE(41) + $PERIOD) LTE @BLOCK THEN
  ASSERT (STATE(41) GTE (PREVSTATE(41) + $PERIOD)) AND (STATE(41) LTE @BLOCK)
  LET cpaid = 0
  LET fpaid = 0
ELSE
  ASSERT STATE(41) EQ PREVSTATE(41)
ENDIF
IF STATE(50) EQ 1 THEN
  ASSERT (STATE(42) EQ (cpaid + STATE(12))) AND (STATE(42) LTE PREVSTATE(35)) AND (STATE(43) EQ fpaid)
ELSE
  ASSERT STATE(50) EQ 2
  ASSERT (STATE(43) EQ (fpaid + STATE(12))) AND (STATE(43) LTE PREVSTATE(36)) AND (STATE(42) EQ cpaid)
ENDIF
RETURN VERIFYOUT(@TOTOUT - 1 @ADDRESS 1 rectok TRUE)
