/* DEPOSIT GATE: the deployed R2T4 gate, pointed at the R2T5 vault. A marker exists only with its vault payment. */
LET gen = $GEN
LET anchoraddr = $ANCHORADDR
LET vaultaddr = $VAULTADDR
ASSERT @INPUT EQ 0
ASSERT STATE(0) EQ gen
ASSERT STATE(2) GT 0
ASSERT STATE(5) EQ PREVSTATE(5)+1
ASSERT STATE(6) EQ PREVSTATE(6)
ASSERT VERIFYOUT(0 @ADDRESS @AMOUNT @TOKENID TRUE)
ASSERT VERIFYOUT(1 anchoraddr 0.00000001 STATE(3) TRUE)
RETURN VERIFYOUT(2 vaultaddr STATE(2) STATE(3) FALSE)
