ASSERT SAMESTATE(80 88) AND SAMESTATE(100 108) AND (PREVSTATE(32) EQ 0) ASSERT (STATE(32) LTE @BLOCK) AND (STATE(32) GTE (@BLOCK-72)) LET j=STATE(33) ASSERT (j GTE 0) AND (j LT 9) AND (j EQ FLOOR(j)) LET cand=STATE(34) ASSERT LEN(cand) EQ 32 LET s=0 LET i=0 WHILE i LT 9 DO ASSERT cand NEQ PREVSTATE(80+i) IF SIGNEDBY(PREVSTATE(80+i)) THEN LET s=s+1 ENDIF LET i=i+1 ENDWHILE IF STATE(59) EQ 2 THEN RETURN s GTE 6 ENDIF ASSERT STATE(59) EQ 1 ASSERT (@BLOCK-PREVSTATE(100+j)) GTE 103680 RETURN (s GTE 3) AND ((s*2) GT 9)
