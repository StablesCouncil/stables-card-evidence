ASSERT (PREVSTATE(32) NEQ 0) AND ((@BLOCK-PREVSTATE(32)) GTE 12096) AND (STATE(32) EQ 0) LET j=PREVSTATE(33) IF (PREVSTATE(59) EQ 1) AND ((@BLOCK-PREVSTATE(100+j)) LT 103680) THEN RETURN SAMESTATE(80 88) AND SAMESTATE(100 108) ENDIF ASSERT SIGNEDBY(PREVSTATE(34)) AND (STATE(80+j) EQ PREVSTATE(34)) ASSERT (STATE(100+j) LTE @BLOCK) AND (STATE(100+j) GTE (@BLOCK-72)) LET i=0 WHILE i LT 9 DO ASSERT (j EQ i) OR (SAMESTATE(80+i 80+i) AND SAMESTATE(100+i 100+i)) LET i=i+1 ENDWHILE RETURN TRUE
