ASSERT (PREVSTATE(54) NEQ 0x00) AND (@BLOCK GTE PREVSTATE(55)) AND (PREVSTATE(27) EQ 0) AND (PREVSTATE(54) EQ SHA3(CONCAT(STATE(140) STATE(150) STATE(141) STATE(151) STATE(142) STATE(152)))) ASSERT SAMESTATE(80 88) AND SAMESTATE(100 108) AND (STATE(56) EQ PREVSTATE(57)) AND SAMESTATE(55 55) AND SAMESTATE(57 57) AND (STATE(54) EQ 0x00) LET chg=0 LET i=0 WHILE i LT 11 DO IF STATE(60+i) NEQ PREVSTATE(60+i) THEN LET chg=chg+1 ENDIF LET i=i+1 ENDWHILE LET hit=0 LET m=0 WHILE m LT 3 DO ASSERT (LEN(STATE(140+m)) EQ 1) AND (LEN(STATE(150+m)) EQ 32) LET st=NUMBER(STATE(140+m)) IF st LT 11 THEN ASSERT STATE(60+st) EQ STATE(150+m) IF PREVSTATE(60+st) NEQ STATE(150+m) THEN LET hit=hit+1 ENDIF ENDIF LET m=m+1 ENDWHILE RETURN chg EQ hit
