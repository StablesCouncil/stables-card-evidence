LET reqaddr=0xC3E36CC7B0B1630F8824375615D5CE49A8DB20107690258BCF55F44691C2A6D2 LET contaddr=0x2231AAE69E5DB3BCF720B9F5A02E76DA10DE34565CB2BF370476B39EA00C5915 LET rectok=0xD92F81E318DC4438DDE36DA47782D12C08502C915CBDF158E14FC109EE0C53E7 ASSERT (GETINADDR(0) EQ reqaddr) OR (GETINADDR(0) EQ contaddr) LET n=STATE(16) ASSERT (@INPUT GTE 1) AND (@INPUT LTE n) AND (n LTE 8) ASSERT GETINTOK(n+2) EQ rectok ASSERT STATE(13) EQ @TOKENID ASSERT STATE(12) GT 0 LET sum=0 LET i=1 WHILE i LTE n DO ASSERT GETINADDR(i) EQ @ADDRESS ASSERT GETINTOK(i) EQ @TOKENID LET sum=sum+GETINAMT(i) LET i=i+1 ENDWHILE ASSERT VERIFYOUT(0 STATE(14) STATE(12) @TOKENID FALSE) LET rem=sum-STATE(12) ASSERT STATE(15) EQ rem IF rem GT 0 THEN RETURN VERIFYOUT(2 @ADDRESS STATE(15) @TOKENID FALSE) ENDIF RETURN rem EQ 0
